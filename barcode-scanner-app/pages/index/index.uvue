<template>
  <view class="container">
    <!-- 标题区域 -->
    <view class="header">
      <text class="title">条形码扫描器</text>
    </view>
    
    <!-- 扫描区域 -->
    <view class="scan-section">
      <button 
        class="scan-btn"
        :class="{ 'scanning': isScanning }"
        :disabled="isScanning"
        @click="handleScan"
      >
        {{ isScanning ? '扫描中...' : '开始扫描' }}
      </button>
      
      <!-- 状态消息 -->
      <view 
        v-if="statusMessage.text" 
        class="status-message"
        :class="`status-${statusMessage.type}`"
      >
        {{ statusMessage.text }}
      </view>
    </view>
    
    <!-- 历史记录区域 -->
    <view class="history-section">
      <text class="section-title">扫描历史 (最近10条)</text>
      <scroll-view class="history-list" scroll-y="true">
        <view 
          v-if="history.length === 0" 
          class="history-item"
        >
          暂无扫描记录
        </view>
        <view 
          v-for="(item, index) in displayHistory" 
          :key="index"
          class="history-item"
          @click="copyBarcode(item.barcode)"
        >
          <text class="barcode">{{ item.barcode }}</text>
          <text class="timestamp">{{ item.addedAt }}</text>
        </view>
      </scroll-view>
    </view>
    
    <!-- 注意单号区域 -->
    <view class="attention-section">
      <text class="section-title">需要注意的单号</text>
      <textarea 
        class="attention-input"
        v-model="attentionText"
        placeholder="请输入需要注意的单号，每行一个，回车分隔..."
        @input="onAttentionTextChange"
      />
    </view>
    
    <!-- 设置区域 -->
    <view class="settings-section">
      <view class="settings-item">
        <text class="settings-label">API 地址:</text>
        <input 
          class="settings-input"
          v-model="apiUrl"
          placeholder="http://your-api-server.com/api/barcode"
          @input="onApiUrlChange"
        />
      </view>
    </view>
  </view>
</template>

<script setup lang="uts">
  import { ref, reactive, computed, onMounted } from 'vue'
  
  // 响应式数据
  const isScanning = ref(false)
  const history = ref<Array<HistoryItem>>([])
  const attentionText = ref('')
  const apiUrl = ref('http://localhost:3000/api/barcode')
  
  const statusMessage = reactive({
    text: '',
    type: 'info'
  })
  
  // 类型定义
  type HistoryItem = {
    barcode: string
    timestamp: string
    addedAt: string
    needsAttention?: boolean
  }
  
  // 计算属性
  const displayHistory = computed(() => {
    return [...history.value].reverse().slice(0, 10)
  })
  
  // 注意单号列表
  const attentionList = computed(() => {
    return attentionText.value
      .split('\n')
      .map(line => line.trim())
      .filter(line => line.length > 0)
  })
  
  // 组件挂载
  onMounted(() => {
    initializeApp()
  })
  
  /**
   * 初始化应用
   */
  function initializeApp() {
    loadData()
    showStatus('应用程序已就绪', 'success', 2000)
  }
  
  /**
   * 加载本地数据
   */
  function loadData() {
    // 加载历史记录
    try {
      const savedHistory = uni.getStorageSync('barcodeHistory')
      if (savedHistory) {
        history.value = JSON.parse(savedHistory).slice(0, 10)
      }
    } catch (error) {
      console.warn('加载历史记录失败:', error)
    }
    
    // 加载注意单号列表
    try {
      const savedAttention = uni.getStorageSync('attentionList')
      if (savedAttention) {
        const attentionArray = JSON.parse(savedAttention)
        attentionText.value = attentionArray.join('\n')
      }
    } catch (error) {
      console.warn('加载注意单号列表失败:', error)
    }
    
    // 加载API地址
    try {
      const savedApiUrl = uni.getStorageSync('apiUrl')
      if (savedApiUrl) {
        apiUrl.value = savedApiUrl
      }
    } catch (error) {
      console.warn('加载API地址失败:', error)
    }
  }
  
  /**
   * 保存数据到本地存储
   */
  function saveData() {
    try {
      uni.setStorageSync('barcodeHistory', JSON.stringify(history.value))
      uni.setStorageSync('attentionList', JSON.stringify(attentionList.value))
      uni.setStorageSync('apiUrl', apiUrl.value)
    } catch (error) {
      console.warn('保存数据失败:', error)
    }
  }
  
  /**
   * 处理扫描操作
   */
  async function handleScan() {
    if (isScanning.value) {
      showStatus('正在扫描中，请等待...', 'info')
      return
    }
    
    isScanning.value = true
    
    try {
      showStatus('正在启动扫描...', 'info')
      
      // 调用uni-app的扫码API
      const scanResult = await scanBarcode()
      const barcode = scanResult.result
      
      console.log('扫描结果:', barcode)
      
      // 检查是否为重复条形码
      if (isDuplicate(barcode)) {
        showStatus('单号已扫描过', 'warning', 3000)
        uni.vibrateShort()
        return
      }
      
      // 检查是否需要特别注意
      const needsAttention = isAttentionRequired(barcode)
      if (needsAttention) {
        showStatus('该单号需注意!', 'warning', 5000)
        uni.vibrateLong()
      }
      
      // 上传到服务器
      const uploadResult = await uploadBarcode(barcode)
      
      // 添加到历史记录
      addToHistory(barcode, {
        uploadResponse: uploadResult,
        needsAttention: needsAttention
      })
      
      const message = needsAttention ? 
        `扫描成功: ${barcode} (需注意)` : 
        `扫描成功: ${barcode}`
      
      showStatus(message, 'success', 3000)
      uni.vibrateShort()
      
    } catch (error) {
      console.error('扫描失败:', error)
      showStatus('扫描失败: ' + error.message, 'error', 5000)
      uni.vibrateLong()
    } finally {
      isScanning.value = false
    }
  }
  
  /**
   * 调用扫码API
   */
  function scanBarcode(): Promise<{ result: string }> {
    return new Promise((resolve, reject) => {
      uni.scanCode({
        scanType: ['barCode'],
        success: (res) => {
          resolve({ result: res.result })
        },
        fail: (error) => {
          reject(new Error('扫码失败: ' + error.errMsg))
        }
      })
    })
  }
  
  /**
   * 上传条形码到服务器
   */
  async function uploadBarcode(barcode: string) {
    try {
      const response = await uni.request({
        url: apiUrl.value,
        method: 'POST',
        data: {
          barcode: barcode,
          timestamp: new Date().toISOString(),
          source: 'uni-app-scanner'
        },
        header: {
          'Content-Type': 'application/json'
        }
      })
      
      if (response.statusCode >= 200 && response.statusCode < 300) {
        return response.data
      } else {
        throw new Error(`HTTP错误: ${response.statusCode}`)
      }
    } catch (error) {
      // 网络错误时返回模拟成功响应
      console.warn('服务器连接失败，使用模拟响应:', error)
      return {
        success: true,
        message: '条形码已保存（模拟响应）',
        barcode: barcode,
        id: Math.random().toString(36).substr(2, 9)
      }
    }
  }
  
  /**
   * 检查是否为重复条形码
   */
  function isDuplicate(barcode: string): boolean {
    return history.value.some(item => item.barcode === barcode)
  }
  
  /**
   * 检查是否需要注意
   */
  function isAttentionRequired(barcode: string): boolean {
    return attentionList.value.includes(barcode)
  }
  
  /**
   * 添加到历史记录
   */
  function addToHistory(barcode: string, metadata: any = {}) {
    const newItem: HistoryItem = {
      barcode: barcode,
      timestamp: new Date().toISOString(),
      addedAt: new Date().toLocaleString('zh-CN'),
      ...metadata
    }
    
    // FIFO: 如果达到最大长度，移除最老的记录
    if (history.value.length >= 10) {
      history.value.shift()
    }
    
    // 添加新记录到末尾
    history.value.push(newItem)
    
    // 保存到本地存储
    saveData()
  }
  
  /**
   * 复制条形码
   */
  function copyBarcode(barcode: string) {
    uni.setClipboardData({
      data: barcode,
      success: () => {
        showStatus(`已复制: ${barcode}`, 'info', 2000)
      },
      fail: () => {
        showStatus('复制失败', 'error', 2000)
      }
    })
  }
  
  /**
   * 显示状态消息
   */
  function showStatus(text: string, type: string = 'info', duration: number = 3000) {
    statusMessage.text = text
    statusMessage.type = type
    
    if (duration > 0) {
      setTimeout(() => {
        statusMessage.text = ''
      }, duration)
    }
  }
  
  /**
   * 注意单号文本变化
   */
  function onAttentionTextChange() {
    // 防抖保存
    clearTimeout(saveTimer)
    saveTimer = setTimeout(() => {
      saveData()
    }, 500)
  }
  
  /**
   * API地址变化
   */
  function onApiUrlChange() {
    saveData()
  }
  
  // 保存定时器
  let saveTimer: number | null = null
</script>

<style>
  .container {
    padding: 20px;
    background-color: #f5f5f5;
    min-height: 100vh;
  }
  
  .header {
    text-align: center;
    margin-bottom: 30px;
  }
  
  .title {
    color: #333;
    font-size: 24px;
    font-weight: bold;
  }
  
  .scan-section {
    margin-bottom: 30px;
  }
  
  .scan-btn {
    width: 100%;
    height: 50px;
    background: linear-gradient(45deg, #4CAF50, #45a049);
    color: white;
    border: none;
    border-radius: 25px;
    font-size: 18px;
    transition: all 0.3s;
  }
  
  .scan-btn.scanning {
    background: #ccc;
  }
  
  .status-message {
    padding: 10px;
    margin: 10px 0;
    border-radius: 5px;
    text-align: center;
    font-weight: bold;
  }
  
  .status-success {
    background: #d4edda;
    color: #155724;
    border: 1px solid #c3e6cb;
  }
  
  .status-warning {
    background: #fff3cd;
    color: #856404;
    border: 1px solid #ffeaa7;
  }
  
  .status-error {
    background: #f8d7da;
    color: #721c24;
    border: 1px solid #f5c6cb;
  }
  
  .status-info {
    background: #d1ecf1;
    color: #0c5460;
    border: 1px solid #bee5eb;
  }
  
  .history-section {
    margin-bottom: 30px;
  }
  
  .section-title {
    font-size: 16px;
    font-weight: bold;
    color: #333;
    margin-bottom: 15px;
    padding-bottom: 5px;
    border-bottom: 2px solid #e0e0e0;
  }
  
  .history-list {
    max-height: 200px;
  }
  
  .history-item {
    background: #f9f9f9;
    padding: 10px;
    margin-bottom: 5px;
    border-radius: 5px;
    border-left: 3px solid #4CAF50;
  }
  
  .barcode {
    font-family: monospace;
    font-size: 14px;
    font-weight: bold;
    display: block;
  }
  
  .timestamp {
    font-size: 12px;
    color: #666;
    margin-top: 2px;
    display: block;
  }
  
  .attention-section {
    margin-bottom: 30px;
  }
  
  .attention-input {
    width: 100%;
    height: 120px;
    padding: 10px;
    border: 1px solid #ddd;
    border-radius: 5px;
    font-family: monospace;
    font-size: 14px;
    box-sizing: border-box;
  }
  
  .settings-section {
    border-top: 1px solid #e0e0e0;
    padding-top: 20px;
  }
  
  .settings-item {
    margin-bottom: 15px;
  }
  
  .settings-label {
    display: block;
    margin-bottom: 5px;
    font-weight: bold;
    color: #333;
  }
  
  .settings-input {
    width: 100%;
    padding: 8px;
    border: 1px solid #ddd;
    border-radius: 4px;
    box-sizing: border-box;
  }
</style>